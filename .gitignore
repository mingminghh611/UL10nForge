__pycache__/
*.py[cod]
.pytest_cache/
*.db
.worktrees/

# Local-only model/runtime payloads are large and reproducible.
models/*.gguf
runtime/

# llama.cpp is a separately cloned repository; install only its runtime output.
llama.cpp/

# Il2CppDumper writes game-specific analysis beside its executable when run directly.
tools/Il2CppDumper/DummyDll/
tools/Il2CppDumper/dump.cs
tools/Il2CppDumper/il2cpp.h
tools/Il2CppDumper/script.json
tools/Il2CppDumper/stringliteral.json

# Keep the issue ledger, ignore generated logs and temporary artifacts.
logs/
.scratch/*
!.scratch/running-issues/
!.scratch/running-issues/*.md

# 中文字体仅提交白名单引用的唯一字体（2026-08-18 单字体收敛：
# Noto Serif CJK SC Medium；2026-09-04 D1 根治新增真 TrueType 版
# .ttf——CFF OTF 禁止再作插件部署源，见问题集 D1），其余不入库
fonts/SimplifiedChinese/*
!fonts/SimplifiedChinese/NotoSerifCJKsc-Medium.otf
!fonts/SimplifiedChinese/NotoSerifCJKsc-Medium.ttf

# 每次汉化自动导出的失败记录（生成产物，不入库）
docs/fail record/

# 各游戏闭环记录与游戏文本样本导出（本地数据，含游戏原文文本，
# 不入库防版权/隐私泄露——开发实证文档保留本地）
docs/all record/

# 识别/覆盖率调查脚本输出（可随时重跑 scripts/*survey*.py 再生成，核心代码 0 引用）
survey_out/

# 阶段 4 外测数据：下载的 zip 与解压的游戏副本（体积大、可重新下载）
ext_downloads/
ext_games/

# Runner/game runtime state (secret-bearing, machine-specific)
review_runtime.json
model_runtime.json
coord_runtime_embed.json
*.log

# TMP bundle 构建的参考字体资产（可随时用 build_tmp_font_bundles.py 重建，148M 不入库）
.ref_fonts/

# 发行包产物（dist/ 由 scripts/_package_0371.py 生成，可重建）
dist/
